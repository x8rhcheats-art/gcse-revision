/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# "no-cache" means revalidate before use but DO keep a copy. It must not be
# "no-store": with no stored copy the browser cannot start the worker while
# offline, so the whole offline mode silently fails at exactly the moment it
# is needed.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache
